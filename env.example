# -- Database --
# Must match the values in docker-compose.yml (They share these variables).
# If you change these, change them here only, since docker-compose reads them.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qte
POSTGRES_USER=qte_user
POSTGRES_PASSWORD=qte_secret

# -- Redis --
REDIS_URL=redis://localhost:6379/0

# -- Exchange API Keys --
# Leave all blank for backtesting. Only needed for live/paper trading.
# Never enable withdrawal permissions on any key used here.
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_TESTNET=true

COINBASE_API_KEY=
COINBASE_SECRET=
COINBASE_PASSPHRASE=
COINBASE_SANDBOX=true

KRAKEN_API_KEY=
KRAKEN_SECRET=

# -- Capital and Safety --
INITIAL_CAPITAL=100000.0
DRY_RUN=true                        # NEVER set false until fully tested on paper

# -- Engine Parameters --
MAX_PORTFOLIO_RISK_PCT=0.02         # 2% max loss per trade
MAX_DRAWDOWN_HALT_PCT=0.15          # halt engine if portfolio drops 15% from peak
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# -- Backtest Cost Assumptions --
BACKTEST_DEFAULT_SLIPPAGE_BPS=5.0   # 5 bps execution slippage
BACKTEST_DEFAULT_COMMISSION_BPS=10.0 # 10 bps (Binance taker rate)
